NODE_ENV=production
PORT=10000

APP_NAME=Travel Automation

# MongoDB
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/travel_automation

# JWT
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=15m

# Cookie
COOKIE_NAME=travel_session
COOKIE_SECURE=true

# CORS
FRONTEND_URL=https://your-render-domain.onrender.com

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# OTP
OTP_PROVIDER=
OTP_API_URL=
OTP_API_KEY=

# CAPTCHA
CAPTCHA_PROVIDER=
CAPTCHA_API_URL=
CAPTCHA_API_KEY=

# Facial verification
FACIAL_PROVIDER=
FACIAL_API_URL=
FACIAL_API_KEY=

# Target site
SITE_BASE_URL=
SITE_USERNAME=
SITE_PASSWORD=

# Encryption
DATA_ENCRYPTION_KEY=

# Application
LOG_LEVEL=info
