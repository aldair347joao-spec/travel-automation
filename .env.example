NODE_ENV=development

PORT=10000

APP_NAME=Travel Automation

MONGODB_URI=

JWT_SECRET=
JWT_EXPIRES_IN=15m

COOKIE_NAME=travel_session
COOKIE_SECURE=false

FRONTEND_URL=

# ==================================================
# TEMPORARY DEVELOPMENT MODE
# ==================================================

# false = application works without login
# true  = normal authentication is required

AUTH_ENABLED=false

DEVELOPMENT_ACCOUNT_ID=development-account

DEVELOPMENT_USER_NAME=Operations Console

DEVELOPMENT_USER_EMAIL=dev@travel-automation.local

# ==================================================
# AUTOMATION
# ==================================================

PROCESS_ROLE=all

AVAILABILITY_INTERVAL_MS=2000

SITE_ADAPTER=mock

MOCK_SLOT_AFTER_MS=5000

MOCK_SLOT_DATE=2026-10-15

MOCK_SLOT_TIME=09:00

# ==================================================
# TELEGRAM
# ==================================================

TELEGRAM_ENABLED=false

TELEGRAM_BOT_TOKEN=

TELEGRAM_CHAT_ID=

# ==================================================
# OTP
# ==================================================

OTP_ENABLED=false

OTP_PROVIDER=

OTP_API_URL=

OTP_API_KEY=

# ==================================================
# CAPTCHA
# ==================================================

CAPTCHA_ENABLED=false

CAPTCHA_PROVIDER=

CAPTCHA_API_URL=

CAPTCHA_API_KEY=

# ==================================================
# BIOID
# ==================================================

BIOID_ENABLED=false

BIOID_HOST=

BIOID_CLIENT_ID=

BIOID_CLIENT_KEY=

BIOID_REGION=west-europe

# ==================================================
# SECURITY
# ==================================================

DATA_ENCRYPTION_KEY=

BOOTSTRAP_TOKEN=

LOG_LEVEL=info
