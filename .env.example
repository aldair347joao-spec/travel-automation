NODE_ENV=development

PORT=10000

MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/travel-automation

JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=15m

DATA_ENCRYPTION_KEY=change-this-to-a-32-character-secret

COOKIE_NAME=travel_session
COOKIE_SECURE=false

AUTH_ENABLED=true

FRONTEND_URL=http://localhost:10000

APP_NAME=Travel Automation

DEVELOPMENT_ACCOUNT_ID=development-account
DEVELOPMENT_USER_NAME=Operations Console
DEVELOPMENT_USER_EMAIL=dev@travel-automation.local

# Site adapter
SITE_ADAPTER=mock

# VFS Portugal / Angola
VFS_BASE_URL=https://visa.vfsglobal.com/ago/en/prt

# Browser
PUPPETEER_HEADLESS=true
VFS_NAVIGATION_TIMEOUT_MS=45000

# Radar
RADAR_MIN_INTERVAL_MS=5000
RADAR_MAX_INTERVAL_MS=30000
RADAR_ERROR_COOLDOWN_MS=30000

BOT2_BATCH_SIZE=20
BOT2_TIMEOUT_MS=10000

# =========================================================
# OTP
# =========================================================

OTP_ENABLED=false

# true apenas para testes locais
OTP_TEST_MODE=true

OTP_TEST_CODE=123456

# 5 minutos
OTP_TTL_SECONDS=300

OTP_MAX_ATTEMPTS=5

# Produção:
# OTP_PROVIDER=
# OTP_API_URL=
# OTP_API_KEY=
# =========================================================
# FACIAL PREFLIGHT
# =========================================================

FACIAL_PREFLIGHT_MIN_SCORE=0.82
FACIAL_PREFLIGHT_MIN_POSITION_SCORE=0.75

# Telegram
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# CAPTCHA
CAPTCHA_ENABLED=false
CAPTCHA_PROVIDER=
CAPTCHA_API_URL=
CAPTCHA_API_KEY=
