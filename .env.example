NODE_ENV=production

PORT=10000

APP_NAME=Travel Automation

PROCESS_ROLE=all

MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/travel_automation

JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=15m

COOKIE_NAME=travel_session
COOKIE_SECURE=true

FRONTEND_URL=https://your-render-domain.onrender.com

BOOTSTRAP_TOKEN=CHANGE_THIS_TO_A_ONE_TIME_RANDOM_SECRET

DATA_ENCRYPTION_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

AVAILABILITY_INTERVAL_MS=2000

SITE_ADAPTER=mock

MOCK_SLOT_AFTER_MS=5000
MOCK_SLOT_DATE=2026-10-15
MOCK_SLOT_TIME=09:00

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

OTP_PROVIDER=
OTP_API_URL=
OTP_API_KEY=

CAPTCHA_PROVIDER=
CAPTCHA_API_URL=
CAPTCHA_API_KEY=

FACIAL_PROVIDER=
FACIAL_API_URL=
FACIAL_API_KEY=

SITE_BASE_URL=
SITE_USERNAME=
SITE_PASSWORD=

LOG_LEVEL=info
